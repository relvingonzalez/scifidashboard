{
    "compilerOptions": {
        "baseUrl": "./src",
        "checkJs": false,
        "jsx": "react",
        "paths": {
            "*": [
                "src/*"
            ]
        },
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ],
    "rules": {
        "react/prop-types": "off"
    },
    "parserOptions": {
        "ecmaFeatures": {
            "jsx": true
        }
    }
}