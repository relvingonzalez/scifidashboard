{
    "compilerOptions": {
        "baseUrl": "./src", // Adjust to your project structure
        "checkJs": false,
        "jsx": "react",
        "paths": {
            "*": [
                "src/*"
            ]
        },
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}